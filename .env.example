# ============================================================================
# AI 模型配置示例 —— 复制为 .env 后填入真实 Key
#
#   cp .env.example .env      # Linux/macOS
#   copy .env.example .env    # Windows
#
# 然后二选一：
#   A. 用 dotenv 工具加载（推荐配合 IDE 的 .env 支持）
#   B. 直接在 PowerShell 里设置环境变量（最省事）：
#        $env:DEEPSEEK_API_KEY="sk-xxx"
#        # 然后重启 mall-portal
#
# ★ .env 已被 .gitignore 排除，不会被提交。
# ★ 本文件（.env.example）只放占位符，可以安全入库。
#
# 获取 Key：https://platform.deepseek.com/api_keys
# ============================================================================

# DeepSeek API Key（必填，格式 sk-xxxxxxxx）
DEEPSEEK_API_KEY=sk-your-key-here

# 模型提供方。设为 deepseek 才会装配 AI 控制器；
# 留空或设为 none 时，/ai/** 返回「AI 模型未配置」提示，其它商城功能不受影响。
AI_CHAT_PROVIDER=deepseek
