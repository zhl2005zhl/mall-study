<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.macro.mall</groupId>
    <artifactId>mall-portal</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>mall-portal</name>
    <description>mall-portal project for mall</description>

    <parent>
        <groupId>com.macro.mall</groupId>
        <artifactId>mall</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.macro.mall</groupId>
            <artifactId>mall-mbg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.macro.mall</groupId>
            <artifactId>mall-security</artifactId>
        </dependency>
        <!--mongodb依赖配置-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!--redis依赖配置-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--集成消息队列-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--支付宝支付Java SDK-->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>${alipay-sdk.version}</version>
        </dependency>
        <!--Spring AI：DeepSeek 模型接入（Tool Calling / Agent Loop 用）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <!--
          MCP Server（第 4 步）：把 MallTools 的能力用 MCP 协议暴露出去，
          任何支持 MCP 的客户端（Claude Desktop、各类 IDE 插件）都能直接调用。

          为什么选 webmvc 版而不是 webflux 版：
            本项目是 Spring MVC + Tomcat 的同步栈。webflux starter 会拉进
            webflux 依赖，和现有的 MVC 栈混在一起容易出现「两种 Web 栈共存」的
            隐式问题（拦截器行为、线程模型都不一样）。
            webmvc 版直接复用现有 servlet 容器，零额外运行时成本。

          为什么放进 mall-portal 而不是单独建模块：
            MCP 暴露的就是 MallTools 那 4 个工具，而工具依赖 portal 的 Service
            与 SecurityContext。单独建模块就要把这两样都抽出去，成本远大于收益。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!--
          ============================ RAG 相关依赖 ============================

          RAG（检索增强生成）需要两样东西：把文本转向量的模型、存向量的库。

          ① embedding 模型：Ollama + bge-m3
             为什么不用 DeepSeek：它**不提供 embedding 接口**（实测 /embeddings 返回 404）。
             为什么选 bge-m3：中文效果公认好（MTEB 中文榜前列），支持 100+ 语种、
             8192 token 长文本，1.2GB 本地可跑、零 API 成本。

          ② 向量库：Milvus
             为什么不用项目已有的 ES：实测确认本机 ES 7.17.3 是 **basic 许可**，
             不支持 kNN 检索（查询报 "Unknown key in [knn]"，_knn_search 端点也不存在）。
             而 Spring AI 的 ES 向量库正是靠 kNN 实现，所以走不通。
             （理论上能改用 script_score 暴力扫描，但那是 O(n)，数据量一大就废，
               而且要多写一套适配代码 —— 不如直接用专业向量库。）

             Milvus 支持 HNSW / IVF 等真 ANN 索引，且是 JD 里出现频率最高的向量库名字。

          注：这两个 starter 都只在配置了对应地址时才生效（见 application.yml 的
              spring.ai.ollama.base-url 与 spring.ai.vectorstore.milvus.client.host），
              不配则 RAG 能力整体不启用，不影响已有功能。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>
